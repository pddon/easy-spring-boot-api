<assembly>
	<id>bin</id>
	<formats>
		<format>zip</format>
	</formats>
	<dependencySets>
		<dependencySet>
			<useProjectArtifact>true</useProjectArtifact>
			<outputDirectory>lib</outputDirectory>
			<excludes>
				<!-- byte-buddy 由 test 作用域的 mockito-core 传递而来（生效 scope=compile），
				     仅测试期使用；与 spring-boot-maven-plugin repackage 的排除保持一致 -->
				<exclude>net.bytebuddy:byte-buddy</exclude>
			</excludes>
		</dependencySet>
	</dependencySets>
	<fileSets>
		<fileSet>
			<directory>${project.build.scriptSourceDirectory}</directory>
			<outputDirectory></outputDirectory>
		</fileSet>

		<fileSet>
			<directory>src/main/resources/scripts</directory>
			<outputDirectory>/bin</outputDirectory>
			<includes>
				<include>*.sh</include>
			</includes>
		</fileSet>

		<fileSet>
			<directory>src/main/resources/conf</directory>
			<outputDirectory>/conf</outputDirectory>
			<includes>
				<include>*.properties</include>
				<include>*.yml</include>
			</includes>
		</fileSet>

		<fileSet>
			<directory>src/main/resources/sql</directory>
			<outputDirectory>/conf/sql</outputDirectory>
		</fileSet>
	</fileSets>
</assembly>