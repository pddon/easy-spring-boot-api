<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pddon.framework</groupId>
        <artifactId>easy-spring-boot-api-parent</artifactId>
        <version>2.0.8</version>
    </parent>

    <artifactId>easy-spring-boot-api-demo</artifactId>
    <version>2.0.8</version>
    <name>easy-spring-boot-api-demo</name>
    <url>https://pddon.cn</url>
    <description>easy-spring-boot-api是一款服务器API开发神器，基于springboot，可以做到零配置零代码即可集成所有api开发需要基础能力。，集成该项目后，不用自己再去处理api安全、加签、验签、加解密、数据脱敏、异常处理、国际化、接口文档、错误码、缓存、分布式锁、应用、渠道管理等等功能。 还提供了java和typescript版本的项目，极大简化了web或者其他客户端应用接入api服务的流程。</description>


    <!-- 定义公共变量 -->
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
		<java.version>1.8</java.version>		
		<docker.image.prefix>192.168.56.22:5000/pddon/framework</docker.image.prefix>
	</properties>
	
	<dependencies>
		<dependency>
			<groupId>com.pddon.framework</groupId>
			<artifactId>easy-spring-boot-api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- 端到端测试使用客户端SDK发起真实HTTP请求 -->
		<dependency>
			<groupId>com.pddon.framework</groupId>
			<artifactId>easy-spring-boot-api-client</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

    <developers>
        <developer>
            <name>Allen</name>
            <email>Allen@pddon.com</email>
            <organization>pddon</organization>
            <organizationUrl>https://www.pddon.cn</organizationUrl>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git://github.com/pddon/easy-spring-boot-api.git</connection>
        <developerConnection>scm:git:ssh://github.com:pddon/easy-spring-boot-api.git</developerConnection>
        <url>https://github.com/pddon/easy-spring-boot-api/tree/master</url>
    </scm>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

	<build>
        <plugins>      
            <!-- 每个测试类使用独立JVM，避免多个Spring上下文注册的静态拦截器互相污染 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <reuseForks>false</reuseForks>
                    <forkCount>1</forkCount>
                </configuration>
            </plugin>
            <!--
              标准可执行jar：由spring-boot-maven-plugin的repackage产出，带classifier=exec，
              主产物仍为普通瘦jar（target/easy-spring-boot-api-demo-2.0.8.jar），两者互不覆盖。
              运行方式：java -jar target/easy-spring-boot-api-demo-2.0.8-exec.jar
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.pddon.framework.demo.easyapi.startup.Startup</mainClass>
                    <!-- 使用classifier避免覆盖maven-jar-plugin产出的主jar -->
                    <classifier>exec</classifier>
                    <!--
                      byte-buddy只被测试期Mockito使用（父POM的spring-boot-starter-test为test范围），
                      repackage时仍会被带入BOOT-INF/lib（3.35MB），这里从可执行包中排除，测试类路径不受影响。
                    -->
                    <excludes>
                        <exclude>
                            <groupId>net.bytebuddy</groupId>
                            <artifactId>byte-buddy</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
              原有assembly仅保留部署包（bin.zip：lib/ + conf/ + bin/），用于脚本化部署；
              不再产出jar-with-dependencies（该形式会丢失Spring Boot自动配置的spring.factories，
              且Main-Class固定为不存在的Main，无法启动）。部署包在install阶段生成。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>${project.name}</id>
                        <configuration>
                            <descriptors>
                                <descriptor>src/main/resources/scripts/assembly.xml</descriptor>
                            </descriptors>
                            <finalName>${project.name}-${project.version}</finalName>
                        </configuration>
                        <phase>install</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
	
</project>
